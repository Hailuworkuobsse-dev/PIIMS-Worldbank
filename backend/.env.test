NODE_ENV=test
PORT=3001
API_BASE_PATH=/v1
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DATABASE_URL="mysql://root:admin@localhost:3307/piims_test"
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-secret-at-least-32-chars-long-aaaaaaaaaaaa
JWT_REFRESH_SECRET=test-refresh-at-least-32-chars-long-bbbbbbbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h
MFA_ISSUER=PIIMS
MFA_REQUIRED_ROLES=

RATE_LIMIT_WINDOW_MS=60000
